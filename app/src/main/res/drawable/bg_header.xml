<?xml version="1.0" encoding="utf-8"?>
<!-- The header block at the top of the settings screen: a deep gradient with rounded bottom
     corners. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="@color/mycar_header_dark"
        android:startColor="@color/mycar_header" />
    <corners
        android:bottomLeftRadius="24dp"
        android:bottomRightRadius="24dp" />
</shape>
