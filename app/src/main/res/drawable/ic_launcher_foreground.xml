<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon foreground: a front-view car in white, with the windshield treated as a dark
    display carrying a teal "screen" line — MyCar's whole idea (the phone's screen shown on the
    car's screen) in one mark. Art is kept inside the 66dp adaptive safe zone so no launcher mask
    clips it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Car body. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M35,75 C32.2,75 30,72.8 30,70 L30,61 C30,57.8 31.6,55.7 35,54.6 L41,42.6 C42,39.9 44,38.5 46.8,38.5 L61.2,38.5 C64,38.5 66,39.9 67,42.6 L73,54.6 C76.4,55.7 78,57.8 78,61 L78,70 C78,72.8 75.8,75 73,75 Z" />

    <!-- Windshield, read as a screen. -->
    <path
        android:pathData="M43.2,54 C43.2,53.3 43.4,52.6 43.8,52 L47.4,43.9 C47.9,42.9 48.9,42.3 50,42.3 L58,42.3 C59.1,42.3 60.1,42.9 60.6,43.9 L64.2,52 C64.6,52.6 64.8,53.3 64.8,54 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="42.3"
                android:endX="54"
                android:endY="54">
                <item android:offset="0.0" android:color="#FF163B6B"/>
                <item android:offset="1.0" android:color="#FF0B1B33"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Teal interface line on the "screen". -->
    <path
        android:fillColor="#FF35D0C0"
        android:pathData="M46.6,50.5 h14.8 a0.9,0.9 0 0 1 0,1.8 h-14.8 a0.9,0.9 0 0 1 0,-1.8 z" />

    <!-- Headlights. -->
    <path
        android:fillColor="#FFFFC24B"
        android:pathData="M33.4,63.9 h6.6 a1.7,1.7 0 0 1 0,3.4 h-6.6 a1.7,1.7 0 0 1 0,-3.4 z" />
    <path
        android:fillColor="#FFFFC24B"
        android:pathData="M68,63.9 h6.6 a1.7,1.7 0 0 1 0,3.4 h-6.6 a1.7,1.7 0 0 1 0,-3.4 z" />
</vector>
