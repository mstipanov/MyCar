<?xml version="1.0" encoding="utf-8"?>
<!--
    Wrapped in a ScrollView: with the landscape lock on, the phone is usually held in landscape,
    where this column is taller than the screen and the update controls used to fall off the
    bottom. fillViewport keeps the portrait look (content vertically centred) while making
    everything reachable in landscape.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/status_idle" />

        <Button
            android:id="@+id/start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/start_mirroring" />

        <Button
            android:id="@+id/stop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:enabled="false"
            android:text="@string/stop_mirroring" />

        <CheckBox
            android:id="@+id/keep_screen_on"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/keep_screen_on" />

        <CheckBox
            android:id="@+id/lock_landscape"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/lock_landscape" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/scale_mode"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/scale_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/scale_fit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/scale_fit" />

            <RadioButton
                android:id="@+id/scale_fill_height"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/scale_fill_height" />

            <RadioButton
                android:id="@+id/scale_fill_width"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/scale_fill_width" />

            <RadioButton
                android:id="@+id/scale_fill"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/scale_fill" />
        </RadioGroup>

        <CheckBox
            android:id="@+id/auto_start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/auto_start" />

        <TextView
            android:id="@+id/auto_start_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textSize="12sp"
            android:text="@string/auto_start_hint" />

        <Button
            android:id="@+id/start_app"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/start_app" />

        <CheckBox
            android:id="@+id/touch_control"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/touch_control" />

        <Button
            android:id="@+id/accessibility_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/open_accessibility_settings" />

        <CheckBox
            android:id="@+id/quick_launch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/quick_launch" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textSize="12sp"
            android:text="@string/quick_launch_hint" />

        <Button
            android:id="@+id/check_updates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/check_updates" />

        <TextView
            android:id="@+id/update_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textSize="12sp"
            android:text="@string/help_text" />

    </LinearLayout>

</ScrollView>
