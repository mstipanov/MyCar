<?xml version="1.0" encoding="utf-8"?>
<!-- App picker with a search box. The ListView gets a fixed height because an AlertDialog's
     custom view is measured wrap-content, where layout_weight would collapse it to nothing. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">

    <EditText
        android:id="@+id/search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/start_app_search"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:maxLines="1" />

    <ListView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="300dp" />

</LinearLayout>
