<?xml version="1.0" encoding="utf-8"?>
<!-- Ordered app-list editor (car launcher and start-apps): up/down/remove rows plus an Add app
     button. The dialog title is set by the caller. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">

    <ListView
        android:id="@+id/launcher_list"
        android:layout_width="match_parent"
        android:layout_height="300dp" />

    <Button
        android:id="@+id/add_app"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/add_launcher_app" />

</LinearLayout>
