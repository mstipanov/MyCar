<?xml version="1.0" encoding="utf-8"?>
<!--
    Accessibility service for (a) tapping the phone from the car touchscreen, (b) accepting the
    system screen-capture prompt for hands-free start, and (c) reading the bounds of a floating
    Picture-in-Picture window so a car drag can grab it. canPerformGestures enables
    dispatchGesture(); canRetrieveWindowContent is needed to find and press Share on the prompt and
    to enumerate windows, and flagRetrieveInteractiveWindows is what makes getWindows() return them.
    The code only ever reads SystemUI's projection window and the PiP window's bounds.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeWindowsChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRetrieveInteractiveWindows"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="true"
    android:description="@string/touch_service_description"
    android:notificationTimeout="100" />
