# Copy to .env, fill in, and `source` it. Never commit this file.
# Create the app at https://www.reddit.com/prefs/apps (type: script).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Preferred: a token scoped to 'read' (see README).
REDDIT_REFRESH_TOKEN=
# Quick alternative (kept on your machine only):
REDDIT_USERNAME=
REDDIT_PASSWORD=
